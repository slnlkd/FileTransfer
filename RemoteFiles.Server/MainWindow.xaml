<Window x:Class="RemoteFiles.Server.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RemoteFiles.Desktop"
        Title="远程文件管理 · 服务端"
        Width="1280" Height="820" MinWidth="1000" MinHeight="600"
        Background="{DynamicResource CanvasBrush}"
        Foreground="{DynamicResource InkBrush}"
        FontFamily="{DynamicResource UiFontFamily}"
        FontSize="12"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel Margin="16">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="远程文件管理" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="服务端" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
            </StackPanel>
            <Button Content="打开日志目录"
                    Click="Logs_Click"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Style="{StaticResource GhostButton}" />
        </Grid>

        <Border DockPanel.Dock="Bottom" Height="24" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="StatusDot" Width="5" Height="5" Fill="{StaticResource MutedBrush}" Margin="0,0,6,0" />
                <TextBlock x:Name="StatusText"
                           Grid.Column="1"
                           Text="选择共享根目录后启动；仅在选定目录内提供文件读写和程序管理。"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{StaticResource MutedBrush}"
                           TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="2"
                            x:Name="BrowserProgressPanel"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <TextBlock x:Name="BrowserProgressText"
                               MaxWidth="240"
                               Margin="12,0,8,0"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{StaticResource MutedBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <ProgressBar x:Name="BrowserProgress"
                                 Width="120"
                                 Height="6"
                                 Maximum="100" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <Border Background="{StaticResource SurfaceBrush}"
                    CornerRadius="{StaticResource PanelCornerRadius}"
                    Effect="{StaticResource CardShadow}" />
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource PanelCornerRadius}"
                    Padding="12">
            <StackPanel>
                <TextBlock Text="服务设置"
                           Style="{StaticResource SectionLabel}"
                           Margin="0,0,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="共享根目录" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                    <TextBox x:Name="RootBox" Grid.Column="1" Margin="8,0" IsReadOnly="True" />
                    <Button x:Name="ChooseButton" Grid.Column="2" Content="选择文件夹"
                            Click="Choose_Click" Style="{StaticResource SecondaryButton}" />
                </Grid>
                <WrapPanel Margin="0,8,0,0">
                    <TextBlock Text="TCP 端口" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                    <TextBox x:Name="PortBox" Text="9501" Width="85" Margin="8,0" />
                    <Button x:Name="StartButton" Content="启动服务" Click="Start_Click" Margin="0,0,4,0"
                            Style="{StaticResource PrimaryButton}" />
                    <Button x:Name="StopButton" Content="停止服务" Click="Stop_Click" IsEnabled="False"
                            Style="{StaticResource DangerButton}" />
                </WrapPanel>
            </StackPanel>
            </Border>
        </Grid>

        <StackPanel DockPanel.Dock="Bottom">
            <TextBlock Text="压缩 / 下载进度（各客户端请求）"
                       Style="{StaticResource SectionLabel}"
                       Margin="2,0,0,4" />
            <DataGrid x:Name="TransferGrid" Height="130" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="路径" Binding="{Binding Path}" Width="*" />
                    <DataGridTextColumn Header="阶段" Binding="{Binding Stage}" Width="240" />
                    <DataGridTemplateColumn Header="进度" Width="200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent}" Height="20" />
                                    <TextBlock Text="{Binding Percent, StringFormat={}{0:F1}%}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <TextBox x:Name="ActivityBox"
                     Height="65"
                     Margin="0,8,0,0"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     VerticalContentAlignment="Top"
                     Padding="8"
                     FontFamily="{StaticResource MonoFontFamily}"
                     FontSize="11" />
        </StackPanel>

        <local:RemoteBrowser x:Name="Browser" />
    </DockPanel>
</Window>
