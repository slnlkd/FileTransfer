<UserControl x:Class="RemoteFiles.Desktop.RemoteBrowser"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RemoteFiles.Desktop">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
    <Style TargetType="TreeViewItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Padding" Value="4,3" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                    <Grid Margin="2,0,3,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border x:Name="Bd" Grid.Row="0" Grid.ColumnSpan="2"
                                Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ToggleButton x:Name="Expander" Grid.Column="0" ClickMode="Press"
                                              Click="TreeExpander_Click"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              Style="{StaticResource TreeExpanderStyle}" />
                                <ContentPresenter x:Name="PART_Header" Grid.Column="1" Margin="4,0,0,0"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center" ContentSource="Header" />
                            </Grid>
                        </Border>
                        <ItemsPresenter x:Name="ItemsHost"
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Margin="0,1,0,0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                        </Trigger>
                        <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

            <local:FileIconConverter x:Key="FileIcon" />
            <local:FileKindConverter x:Key="FileKind" />
            <local:FileSizeConverter x:Key="FileSize" />
            <ContextMenu x:Key="ColumnSettingsMenu" />
            <Geometry x:Key="BrowserUpGeometry">M8,13 V3 M4,7 L8,3 L12,7</Geometry>
            <Geometry x:Key="BrowserRefreshGeometry">M13,3 V7 H9 M13,7 A5,5 0 1 0 12.5,11</Geometry>
            <Geometry x:Key="BrowserFolderGeometry">M2,5 V12.5 H14 V5.5 H8 L6.5,3.5 H2 Z</Geometry>
            <Geometry x:Key="BrowserBackGeometry">M13,8 H3 M7.5,3.5 L3,8 L7.5,12.5</Geometry>
            <Geometry x:Key="BrowserAnnotateGeometry">M3,10.5 L10.5,3 L13,5.5 L5.5,13 H3 Z M9,4.5 L11.5,7</Geometry>
            <Geometry x:Key="BrowserDeleteGeometry">M2.5,4.5 H13.5 M6,4.5 V2.5 H10 V4.5 M4,4.5 L4.75,13.5 H11.25 L12,4.5 M6.5,7 V11 M9.5,7 V11</Geometry>
            <Geometry x:Key="BrowserProgressGeometry">M2.5,3.5 V13 H14 M5.5,10.5 V8.5 M9,10.5 V6 M12.5,10.5 V3.5</Geometry>
            <Geometry x:Key="NgAllGeometry">M3,4 H13 M3,8 H13 M3,12 H13</Geometry>
            <Style x:Key="BrowserCommand" TargetType="Button" BasedOn="{StaticResource ToolbarButton}" />
            <Style x:Key="BrowserNavButton" TargetType="Button" BasedOn="{StaticResource BrowserCommand}">
                <Setter Property="Width" Value="32" />
                <Setter Property="Padding" Value="0" />
            </Style>
            <Style x:Key="BrowserAnnotateCommand" TargetType="Button" BasedOn="{StaticResource BrowserCommand}">
                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Background" Value="{DynamicResource HeaderBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="NgToolbarCommand" TargetType="Button" BasedOn="{StaticResource BrowserCommand}" />
            <Style x:Key="NgDatePreset" TargetType="Button" BasedOn="{StaticResource NgToolbarCommand}">
                <Style.Triggers>
                    <Trigger Property="Selector.IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="BrowserToolbarDivider" TargetType="Border">
                <Setter Property="Width" Value="1" />
                <Setter Property="Height" Value="16" />
                <Setter Property="Margin" Value="6,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Background" Value="{DynamicResource LineBrush}" />
            </Style>
            <Style x:Key="NgStatusCircle" TargetType="FrameworkElement">
                <Setter Property="Width" Value="10" />
                <Setter Property="Height" Value="10" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <ControlTemplate x:Key="NgCompletedStatus" TargetType="Control">
                <Canvas Style="{StaticResource NgStatusCircle}">
                    <Ellipse x:Name="Dot" Fill="{DynamicResource SuccessBrush}" Style="{StaticResource NgStatusCircle}" />
                    <Path x:Name="Check" Stretch="None" Data="M2.5,5.1 L4.2,6.85 L7.5,3.35" Stroke="{DynamicResource SurfaceBrush}"
                          StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                </Canvas>
            </ControlTemplate>
            <Style x:Key="NgStatusDot" TargetType="Control">
                <Setter Property="Width" Value="12" />
                <Setter Property="Height" Value="12" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="IsHitTestVisible" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Control">
                            <Ellipse x:Name="Dot" Fill="{TemplateBinding Foreground}" Style="{StaticResource NgStatusCircle}" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="NgBatchStatusDot" TargetType="Control" BasedOn="{StaticResource NgStatusDot}">
                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Annotated}" Value="True">
                        <Setter Property="Template" Value="{StaticResource NgCompletedStatus}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="NgBatchButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                <Setter Property="Height" Value="{StaticResource CompactControlHeight}" />
                <Setter Property="Background" Value="{DynamicResource HeaderBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
                <Setter Property="KeyboardNavigation.AcceptsReturn" Value="True" />
                <Setter Property="AutomationProperties.HelpText" Value="未标注" />
                <Style.Triggers>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    </Trigger>
                    <DataTrigger Binding="{Binding Annotated}" Value="True">
                        <Setter Property="AutomationProperties.HelpText" Value="已标注" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="NgStatusFilterOption" TargetType="RadioButton">
                <Setter Property="Height" Value="{StaticResource ToolbarControlHeight}" />
                <Setter Property="Padding" Value="8,0" />
                <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource ButtonFocusVisualStyle}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Chip" Padding="{TemplateBinding Padding}" Background="Transparent" CornerRadius="{StaticResource ControlCornerRadius}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource RowHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="NgDayExpander" TargetType="Expander">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Expander">
                            <Border CornerRadius="{StaticResource PanelCornerRadius}" Background="{DynamicResource SurfaceBrush}" Padding="4,4,4,0">
                                <StackPanel>
                                    <ToggleButton Foreground="{DynamicResource InkBrush}" FocusVisualStyle="{x:Null}"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                  Content="{TemplateBinding Header}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="DayHeader" Background="{DynamicResource HeaderBrush}" CornerRadius="4" Padding="8,4">
                                                    <DockPanel>
                                                        <Path x:Name="Arrow" DockPanel.Dock="Left" Margin="0,0,8,0" VerticalAlignment="Center"
                                                              Data="M4,2 L8,6 L4,10" StrokeThickness="1.5" Stroke="{DynamicResource MutedBrush}" />
                                                        <ContentPresenter />
                                                    </DockPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="DayHeader" Property="Background" Value="{DynamicResource RowHoverBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Arrow" Property="Data" Value="M2,4 L6,8 L10,4" />
                                                    </Trigger>
                                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                                        <Setter TargetName="DayHeader" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <ContentPresenter x:Name="DayContent" Visibility="Collapsed" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsExpanded" Value="True">
                                    <Setter TargetName="DayContent" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="NgDayCount" TargetType="Border">
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Background" Value="{DynamicResource HeaderBrush}" />
                <Setter Property="Padding" Value="7,2" />
                <Setter Property="Margin" Value="6,0,0,0" />
            </Style>
            <Style x:Key="BrowserColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridColumnHeaderStyle}">
                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
                <Setter Property="SeparatorBrush" Value="{DynamicResource LineBrush}" />
                <Setter Property="SeparatorVisibility" Value="Visible" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="Padding" Value="8,0" />
                <Setter Property="ToolTip" Value="右键选择显示列" />
                <Setter Property="ContextMenu" Value="{StaticResource ColumnSettingsMenu}" />
            </Style>
            <Style x:Key="FileMenuSeparator" TargetType="Separator" BasedOn="{StaticResource MenuSeparator}" />
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel>
        <!-- 路径栏随窗口缩放，文件操作和 NG 操作在右侧分组。 -->
        <Border DockPanel.Dock="Top"
                Padding="{StaticResource BrowserToolbarPadding}"
                Background="{DynamicResource HeaderBrush}"
                BorderBrush="{DynamicResource HairlineBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            x:Name="NavHost"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Button Click="Parent_Click"
                            Style="{StaticResource BrowserNavButton}"
                            AutomationProperties.Name="返回上一级目录"
                            ToolTip="返回上一级目录">
                        <Path Data="{StaticResource BrowserUpGeometry}" Style="{StaticResource IconGlyph}" />
                    </Button>
                    <Button Click="Refresh_Click"
                            Style="{StaticResource BrowserNavButton}"
                            AutomationProperties.Name="刷新当前目录"
                            ToolTip="刷新当前目录">
                        <Path Data="{StaticResource BrowserRefreshGeometry}" Style="{StaticResource IconGlyph}" />
                    </Button>
                </StackPanel>

                <!-- 路径条：占用中间的弹性空间，深路径横向滚动并自动滚到最右侧。 -->
                <Border x:Name="PathBar" Grid.Column="1"
                        Margin="6,0,8,0"
                        Padding="0"
                        MinWidth="140"
                        MinHeight="{StaticResource ToolbarControlHeight}"
                        VerticalAlignment="Center"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource ControlCornerRadius}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
                            <Style.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                    <DockPanel VerticalAlignment="Center" Margin="8,0">
                        <Path DockPanel.Dock="Left" Data="{StaticResource BrowserFolderGeometry}"
                              Style="{StaticResource IconGlyph}" Stroke="{DynamicResource MutedBrush}"
                              Margin="0,0,5,0" VerticalAlignment="Center" />
                        <Button x:Name="CopyPathButton" DockPanel.Dock="Right"
                                Width="26" Height="24" Padding="0" Margin="4,0,0,0"
                                Style="{StaticResource GhostButton}"
                                IsEnabled="False" Click="CopyPath_Click"
                                AutomationProperties.Name="复制完整路径" ToolTip="复制完整路径">
                            <Path Data="{StaticResource IconRestoreGeometry}" Style="{StaticResource IconGlyph}" />
                        </Button>
                        <Border x:Name="BusyIndicator" DockPanel.Dock="Right"
                                Margin="8,0,0,0" VerticalAlignment="Center"
                                Background="Transparent" BorderThickness="0" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="BusyText" MaxWidth="200" VerticalAlignment="Center"
                                           FontSize="12" FontWeight="Normal" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource MutedBrush}" Text="正在处理…"
                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Visibility, ElementName=ProgressPanel}" Value="Visible">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button x:Name="CancelButton" Margin="6,0,0,0" Padding="6,0"
                                        Height="24" VerticalAlignment="Center" Style="{StaticResource GhostButton}"
                                        Click="Cancel_Click" Content="取消" Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                        <ScrollViewer x:Name="BreadcrumbScroll"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled"
                                      VerticalAlignment="Center">
                            <StackPanel x:Name="Breadcrumb"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center" />
                        </ScrollViewer>
                    </DockPanel>
                    <ProgressBar x:Name="BusyProgress" Height="2" VerticalAlignment="Bottom"
                                 Margin="2,0" IsIndeterminate="True" IsHitTestVisible="False">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                <Setter Property="Visibility" Value="{Binding Visibility, ElementName=BusyIndicator}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Visibility, ElementName=ProgressPanel}" Value="Visible">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                        <ProgressBar.Template>
                            <ControlTemplate TargetType="ProgressBar">
                                <Grid x:Name="PART_Track" ClipToBounds="True">
                                    <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                            Background="{TemplateBinding Foreground}" />
                                    <Border x:Name="Sweep" Background="{TemplateBinding Foreground}" Visibility="Collapsed">
                                        <Border.RenderTransform>
                                            <ScaleTransform x:Name="SweepScale" ScaleX="0" />
                                        </Border.RenderTransform>
                                    </Border>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsIndeterminate" Value="True">
                                        <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="Sweep" Property="Visibility" Value="Visible" />
                                        <Trigger.EnterActions>
                                            <BeginStoryboard x:Name="PathSweep">
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetName="SweepScale" Storyboard.TargetProperty="ScaleX"
                                                                     From="0" To="1" Duration="0:0:1.5" />
                                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Sweep" Storyboard.TargetProperty="Opacity">
                                                        <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.3" />
                                                        <LinearDoubleKeyFrame KeyTime="0:0:0.4" Value="1" />
                                                        <LinearDoubleKeyFrame KeyTime="0:0:1.1" Value="1" />
                                                        <LinearDoubleKeyFrame KeyTime="0:0:1.5" Value="0" />
                                                    </DoubleAnimationUsingKeyFrames>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <RemoveStoryboard BeginStoryboardName="PathSweep" />
                                        </Trigger.ExitActions>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ProgressBar.Template>
                    </ProgressBar>
                    </Grid>
                </Border>

                <StackPanel x:Name="FilterHost" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Click="Upload_Click"
                            Style="{StaticResource BrowserCommand}"
                            AutomationProperties.Name="上传"
                            ToolTip="上传文件到当前目录">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconUploadGeometry}" Style="{StaticResource IconGlyph}" Margin="0,0,5,0" />
                            <TextBlock Text="上传" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Margin="6,0" Style="{StaticResource BrowserToolbarDivider}" />
                    <!-- 本机个性化过滤（如只看NG）放在标注按钮左侧，和标注形成一组。 -->
                    <StackPanel x:Name="FilterRightHost" Orientation="Horizontal" VerticalAlignment="Center" />
                    <Button x:Name="NgOverviewOpenButton" Visibility="Collapsed" MinWidth="72" Margin="0,0,4,0"
                            Click="NgOverviewOpen_Click" Style="{StaticResource BrowserAnnotateCommand}"
                            AutomationProperties.Name="NG 标注进度" ToolTip="查看 NG 标注进度">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource BrowserProgressGeometry}" Style="{StaticResource IconGlyph}" Margin="0,0,5,0" />
                            <TextBlock Text="进度" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="AnnotateButton"
                            MinWidth="72"
                            Margin="0,0,2,0"
                            Click="Annotate_Click"
                            Style="{StaticResource BrowserAnnotateCommand}"
                            AutomationProperties.Name="标注"
                            ToolTip="为选中的图片添加异常标注">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource BrowserAnnotateGeometry}" Style="{StaticResource IconGlyph}" Margin="0,0,5,0" />
                            <TextBlock Text="标注" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 浏览器状态 / 传输进度 -->
        <Border x:Name="StatusBar"
                DockPanel.Dock="Bottom"
                Height="24"
                Margin="0,4,0,0"
                Padding="2,0"
                Background="Transparent"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="BrowserStatusDot"
                             Width="7" Height="7"
                             Margin="0,0,7,0"
                             Fill="{DynamicResource MutedBrush}" />
                    <TextBlock Grid.Column="1"
                               x:Name="StatusText"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{DynamicResource MutedBrush}"
                               Text="右键查看更多操作"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
                <StackPanel Grid.Column="1"
                            x:Name="ProgressPanel"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Visibility="Collapsed">
                    <TextBlock x:Name="UploadText"
                               MaxWidth="220"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{DynamicResource MutedBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <ProgressBar x:Name="UploadProgress"
                                 Width="140" Height="6"
                                 Maximum="100" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 目录树和文件列表使用同一底色，中间保留可拖动的分隔线。 -->
        <Grid Background="{DynamicResource SurfaceBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" MinWidth="136" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <Border DockPanel.Dock="Top"
                        Height="{Binding ColumnHeaderHeight, ElementName=FileGrid}"
                        Padding="12,0"
                        BorderBrush="{DynamicResource HairlineBrush}"
                        BorderThickness="0,0,0,1">
                    <TextBlock VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{DynamicResource MutedBrush}"
                               Text="目录" />
                </Border>
                <TreeView x:Name="FolderTree"
                          Padding="8,4"
                          MouseDoubleClick="Tree_DoubleClick"
                          SelectedItemChanged="Tree_Selected">
                    <TreeView.Template>
                        <ControlTemplate TargetType="TreeView">
                            <Border x:Name="TreeSurface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                <ScrollViewer FocusVisualStyle="{x:Null}" CanContentScroll="False"
                                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </ControlTemplate>
                    </TreeView.Template>
                </TreeView>
            </DockPanel>

            <Border Grid.Column="1" VerticalAlignment="Top"
                    Height="{Binding ColumnHeaderHeight, ElementName=FileGrid}"
                    BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1" />
            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                          AutomationProperties.Name="调整目录栏宽度" />

            <Grid Grid.Column="2" x:Name="FileArea"
                  AllowDrop="True"
                  DragOver="Grid_DragOver"
                  Drop="Grid_Drop">
                <DataGrid x:Name="FileGrid"
                          AutoGenerateColumns="False"
                          BorderThickness="0"
                          ColumnHeaderStyle="{StaticResource BrowserColumnHeader}"
                          GridLinesVisibility="None"
                          IsReadOnly="True"
                          MouseDoubleClick="Grid_DoubleClick"
                          PreviewKeyDown="Grid_PreviewKeyDown"
                          SelectionMode="Extended"
                          Sorting="Grid_Sorting">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource DataGridRowStyle}">
                            <Setter Property="BorderThickness" Value="0" />
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridCellStyle}">
                            <Setter Property="Padding" Value="8,0" />
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="名称" SortMemberPath="Name" Width="*" MinWidth="240">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Image Width="16" Height="16"
                                               Margin="0,0,6,0"
                                               VerticalAlignment="Center"
                                               Source="{Binding Converter={StaticResource FileIcon}}" />
                                        <TextBlock x:Name="EntryName" Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTipService.InitialShowDelay="650">
                                            <TextBlock.ToolTip>
                                                <ToolTip MaxWidth="390">
                                                    <StackPanel DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ToolTip}}">
                                                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                                        <StackPanel Margin="0,4,0,0">
                                                            <StackPanel.Style>
                                                                <Style TargetType="StackPanel">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsDirectory}" Value="False">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </StackPanel.Style>
                                                            <TextBlock Text="{Binding ModifiedLocal, StringFormat=修改时间：{0:yyyy.MM.dd HH:mm}}" />
                                                            <TextBlock Text="{Binding AnnotationStatus, StringFormat=标注状态：{0}}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding AnnotationStatus}" Value="">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </ToolTip>
                                            </TextBlock.ToolTip>
                                        </TextBlock>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsImage}" Value="True" />
                                                <Condition Binding="{Binding AnnotationStatus}" Value="已标注" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="EntryName" Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                        </MultiDataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="类型"
                                            Width="64"
                                            Binding="{Binding Converter={StaticResource FileKind}}"
                                            SortMemberPath="Kind">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="大小"
                                            Width="76"
                                            Binding="{Binding Converter={StaticResource FileSize}}"
                                            SortMemberPath="Size">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource BrowserColumnHeader}">
                                    <Setter Property="HorizontalContentAlignment" Value="Right" />
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn x:Name="CreatedTimeColumn" Header="创建时间"
                                            Width="116"
                                            Binding="{Binding CreatedLocal, StringFormat={}{0:yyyy.MM.dd HH:mm}}"
                                            SortMemberPath="CreatedLocal">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn x:Name="ModifiedTimeColumn" Header="修改时间"
                                            Width="116"
                                            Binding="{Binding ModifiedLocal, StringFormat={}{0:yyyy.MM.dd HH:mm}}"
                                            SortMemberPath="ModifiedLocal">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 日期层显示批次状态，批次层显示图片状态。 -->
                        <DataGridTemplateColumn Header="标注状态"
                                                Width="88"
                                                SortMemberPath="AnnotationStatus"
                                                Visibility="Collapsed">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse x:Name="Dot"
                                                 Width="7" Height="7"
                                                 Margin="0,0,6,0"
                                                 VerticalAlignment="Center"
                                                 Fill="Transparent" />
                                        <TextBlock x:Name="StateText"
                                                   Text="{Binding AnnotationStatus}"
                                                   FontSize="11"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding AnnotationStatus}" Value="已标注">
                                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                            <Setter TargetName="StateText" Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding AnnotationStatus}" Value="未标注">
                                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource WarningBrush}" />
                                            <Setter TargetName="StateText" Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding AnnotationStatus}" Value="未知">
                                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource SubtleBrush}" />
                                            <Setter TargetName="StateText" Property="Foreground" Value="{DynamicResource SubtleBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Border x:Name="EmptyState"
                        Margin="0,26,0,0"
                        Padding="0,36,0,0"
                        Background="{DynamicResource SurfaceBrush}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top">
                        <TextBlock x:Name="EmptyText"
                                   HorizontalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource MutedBrush}"
                                   Text="连接后可浏览共享目录" />
                        <Button x:Name="EmptyUploadButton"
                                Margin="0,12,0,0"
                                HorizontalAlignment="Center"
                                Click="Upload_Click"
                                Content="上传文件"
                                Style="{StaticResource PrimaryButton}"
                                Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <Border x:Name="NgOverviewPanel" Visibility="Collapsed" AutomationProperties.Name="NG 标注进度"
                        Background="{DynamicResource SurfaceBrush}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="{DynamicResource HeaderBrush}" Padding="12,2">
                            <DockPanel>
                                <Button x:Name="NgOverviewReturnButton" DockPanel.Dock="Right"
                                        Width="{StaticResource ToolbarControlHeight}" Padding="0" Margin="6,2,0,0" VerticalAlignment="Top"
                                        Click="NgOverviewReturn_Click" AutomationProperties.Name="返回文件列表" ToolTip="返回文件列表"
                                        Style="{StaticResource NgToolbarCommand}">
                                    <Path Data="{StaticResource BrowserBackGeometry}" Style="{StaticResource IconGlyph}" />
                                </Button>
                                <WrapPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,2" VerticalAlignment="Center">
                                        <TextBox x:Name="NgStartDate" Width="90" Margin="0,0,6,0"
                                                 AutomationProperties.Name="开始日期" Style="{StaticResource ToolbarTextInput}"
                                                 KeyDown="NgOverviewDate_KeyDown" TextChanged="NgOverviewDate_TextChanged" ToolTip="开始日期，格式 yyyy-MM-dd" />
                                        <TextBlock Text="至" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                                        <TextBox x:Name="NgEndDate" Width="90" Margin="0,0,6,0"
                                                 AutomationProperties.Name="结束日期" Style="{StaticResource ToolbarTextInput}"
                                                 KeyDown="NgOverviewDate_KeyDown" TextChanged="NgOverviewDate_TextChanged" ToolTip="结束日期，格式 yyyy-MM-dd" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,2" VerticalAlignment="Center">
                                        <Button Content="查询" Click="NgOverviewQuery_Click" Style="{StaticResource NgToolbarCommand}" />
                                        <Border Style="{StaticResource BrowserToolbarDivider}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,2" VerticalAlignment="Center">
                                        <Button x:Name="NgTodayButton" Content="今天" Click="NgOverviewToday_Click" Style="{StaticResource NgDatePreset}" />
                                        <Button x:Name="NgLastWeekButton" Content="近 7 天" Click="NgOverviewLastWeek_Click" Style="{StaticResource NgDatePreset}" />
                                        <Border Style="{StaticResource BrowserToolbarDivider}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,2" VerticalAlignment="Center">
                                        <RadioButton x:Name="NgAllFilter" GroupName="NgOverviewStatus" IsChecked="True" ToolTip="全部"
                                                     AutomationProperties.Name="全部" Checked="NgOverviewFilter_Changed" Style="{StaticResource NgStatusFilterOption}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource NgAllGeometry}" Stroke="{DynamicResource AccentBrush}" VerticalAlignment="Center" Style="{StaticResource IconGlyph}" />
                                                <TextBlock Margin="4,0,0,0" VerticalAlignment="Center">
                                                    <Run Text="全部" /><Run x:Name="NgAllCount" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="NgPendingFilter" GroupName="NgOverviewStatus" ToolTip="未标注"
                                                     AutomationProperties.Name="未标注" Checked="NgOverviewFilter_Changed" Style="{StaticResource NgStatusFilterOption}">
                                            <StackPanel Orientation="Horizontal">
                                                <Control Foreground="{DynamicResource WarningBrush}" Style="{StaticResource NgStatusDot}" />
                                                <TextBlock Margin="4,0,0,0" VerticalAlignment="Center">
                                                    <Run Text="未标注" /><Run x:Name="NgPendingCount" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="NgDoneFilter" GroupName="NgOverviewStatus" ToolTip="已标注"
                                                     AutomationProperties.Name="已标注" Checked="NgOverviewFilter_Changed" Style="{StaticResource NgStatusFilterOption}">
                                            <StackPanel Orientation="Horizontal">
                                                <Control Template="{StaticResource NgCompletedStatus}" Style="{StaticResource NgStatusDot}" />
                                                <TextBlock Margin="4,0,0,0" VerticalAlignment="Center">
                                                    <Run Text="已标注" /><Run x:Name="NgDoneCount" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </RadioButton>
                                    </StackPanel>
                                </WrapPanel>
                            </DockPanel>
                        </Border>
                        <TextBlock x:Name="NgOverviewMessage" DockPanel.Dock="Top" Margin="8,6,8,0"
                                   TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Visibility="Collapsed" />
                        <ScrollViewer x:Name="NgOverviewScroll" FocusVisualStyle="{x:Null}" Background="{DynamicResource SurfaceBrush}" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="NgOverviewDays" Margin="10,8,10,10">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Expander Margin="0,0,0,4" IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Style="{StaticResource NgDayExpander}">
                                            <Expander.Header>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Date, StringFormat={}{0:yyyy.MM.dd}}" FontWeight="SemiBold"
                                                               VerticalAlignment="Center" Foreground="{DynamicResource InkBrush}" />
                                                    <Border VerticalAlignment="Center" Style="{StaticResource NgDayCount}"
                                                            AutomationProperties.Name="{Binding ProgressDetails}"
                                                            ToolTip="{Binding ProgressDetails}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Control Foreground="{DynamicResource MutedBrush}">
                                                                <Control.Style>
                                                                    <Style TargetType="Control" BasedOn="{StaticResource NgStatusDot}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsComplete}" Value="True">
                                                                                <Setter Property="Template" Value="{StaticResource NgCompletedStatus}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Control.Style>
                                                            </Control>
                                                            <TextBlock Text="{Binding Progress}" Margin="4,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsComplete}" Value="True">
                                                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Expander.Header>
                                            <ItemsControl ItemsSource="{Binding VisibleBatches}" Margin="8,4,2,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button MinWidth="50" MaxWidth="220" Margin="0,0,6,4" Padding="6,0"
                                                                HorizontalContentAlignment="Stretch" Click="NgBatch_Click"
                                                                AutomationProperties.Name="{Binding Name, StringFormat=标注批次 {0}}"
                                                                Style="{StaticResource NgBatchButton}">
                                                            <Button.ToolTip>
                                                                <ToolTip>
                                                                    <StackPanel>
                                                                        <TextBlock Text="{Binding PlacementTarget.(AutomationProperties.HelpText), RelativeSource={RelativeSource AncestorType=ToolTip}}" />
                                                                        <TextBlock Text="{Binding PlacementTarget.DataContext.Path, RelativeSource={RelativeSource AncestorType=ToolTip}}" />
                                                                    </StackPanel>
                                                                </ToolTip>
                                                            </Button.ToolTip>
                                                            <DockPanel>
                                                                <Control DockPanel.Dock="Right" Margin="4,0,0,0" Style="{StaticResource NgBatchStatusDot}" />
                                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"
                                                                           HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{DynamicResource InkBrush}" />
                                                            </DockPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
