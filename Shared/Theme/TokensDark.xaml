<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 夜间模式：深灰底 + 提亮钢蓝，保持和日间一致的信息层级。 -->
    <SolidColorBrush x:Key="CanvasBrush" Color="#1B1E22" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#24282D" />
    <SolidColorBrush x:Key="InkBrush" Color="#E7E9EC" />
    <SolidColorBrush x:Key="MutedBrush" Color="#A9AFB6" />
    <SolidColorBrush x:Key="SubtleBrush" Color="#7F868E" />
    <SolidColorBrush x:Key="LineBrush" Color="#363C43" />
    <SolidColorBrush x:Key="HairlineBrush" Color="#2C3137" />
    <SolidColorBrush x:Key="HeaderBrush" Color="#202429" />
    <SolidColorBrush x:Key="TableHeaderBrush" Color="#272C32" />
    <SolidColorBrush x:Key="RowHoverBrush" Color="#2C3E4A" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#35505F" />
    <SolidColorBrush x:Key="SelectionBorderBrush" Color="#5E8AA3" />
    <SolidColorBrush x:Key="AccentBrush" Color="#7FB3CC" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#9AC8DD" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#26343C" />
    <SolidColorBrush x:Key="DangerBrush" Color="#F08A80" />
    <SolidColorBrush x:Key="WarningBrush" Color="#E2B45E" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#6FCB90" />
    <SolidColorBrush x:Key="FocusBrush" Color="#7FB3CC" />
    <SolidColorBrush x:Key="HoverOverlayBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="PressedOverlayBrush" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="BusyOverlayBrush" Color="#D924282D" />

    <DropShadowEffect x:Key="CardShadow"
                      BlurRadius="8"
                      Direction="270"
                      Opacity="0.35"
                      ShadowDepth="2"
                      Color="#000000" />

    <FontFamily x:Key="UiFontFamily">Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="MonoFontFamily">Consolas, Cascadia Mono, Microsoft YaHei UI</FontFamily>

    <Thickness x:Key="ButtonPadding">8,3,8,3</Thickness>
    <Thickness x:Key="InputPadding">8,3,8,3</Thickness>
    <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="PanelCornerRadius">4</CornerRadius>

</ResourceDictionary>
