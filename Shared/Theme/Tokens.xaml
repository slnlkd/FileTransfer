<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 中性灰 + 低饱和钢蓝，避免品牌化的“设计系统”观感。 -->
    <SolidColorBrush x:Key="CanvasBrush" Color="#F3F3F3" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InkBrush" Color="#1F1F1F" />
    <SolidColorBrush x:Key="MutedBrush" Color="#616161" />
    <SolidColorBrush x:Key="SubtleBrush" Color="#8A8A8A" />
    <SolidColorBrush x:Key="LineBrush" Color="#D6D6D6" />
    <SolidColorBrush x:Key="HairlineBrush" Color="#ECECEC" />
    <SolidColorBrush x:Key="HeaderBrush" Color="#F7F7F7" />
    <SolidColorBrush x:Key="RowHoverBrush" Color="#F5F5F5" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#CCE8FF" />
    <SolidColorBrush x:Key="SelectionBorderBrush" Color="#99D1FF" />
    <SolidColorBrush x:Key="AccentBrush" Color="#2B5F75" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#244E60" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#E5EDF2" />
    <SolidColorBrush x:Key="DangerBrush" Color="#B42318" />
    <SolidColorBrush x:Key="WarningBrush" Color="#8A5A00" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#1A7F37" />
    <SolidColorBrush x:Key="FocusBrush" Color="#2B5F75" />

    <!-- 保持 Windows 本地字体和桌面密度。 -->
    <FontFamily x:Key="UiFontFamily">Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="MonoFontFamily">Consolas, Cascadia Mono, Microsoft YaHei UI</FontFamily>

    <Thickness x:Key="ButtonPadding">8,3,8,3</Thickness>
    <Thickness x:Key="InputPadding">8,3,8,3</Thickness>
    <CornerRadius x:Key="ControlCornerRadius">2</CornerRadius>
    <CornerRadius x:Key="PanelCornerRadius">3</CornerRadius>

</ResourceDictionary>
