<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 中性冷灰 + 低饱和钢蓝，避免品牌化的“设计系统”观感。 -->
    <SolidColorBrush x:Key="CanvasBrush" Color="#F4F6F8" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InkBrush" Color="#202124" />
    <SolidColorBrush x:Key="MutedBrush" Color="#5F6368" />
    <SolidColorBrush x:Key="SubtleBrush" Color="#8A8F94" />
    <SolidColorBrush x:Key="LineBrush" Color="#E2E5E9" />
    <SolidColorBrush x:Key="HairlineBrush" Color="#EEF0F2" />
    <SolidColorBrush x:Key="HeaderBrush" Color="#F7F8FA" />
    <SolidColorBrush x:Key="TableHeaderBrush" Color="#F1F3F5" />
    <SolidColorBrush x:Key="RowHoverBrush" Color="#F7F9FB" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#E7F0F6" />
    <SolidColorBrush x:Key="SelectionBorderBrush" Color="#A9C6D8" />
    <SolidColorBrush x:Key="AccentBrush" Color="#2B5F75" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#244E60" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#E5EDF2" />
    <SolidColorBrush x:Key="DangerBrush" Color="#B42318" />
    <SolidColorBrush x:Key="WarningBrush" Color="#8A5A00" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#1A7F37" />
    <SolidColorBrush x:Key="FocusBrush" Color="#2B5F75" />

    <!-- 只给卡片背景使用的极轻投影，正文不参与渲染效果。 -->
    <DropShadowEffect x:Key="CardShadow"
                      BlurRadius="6"
                      Direction="270"
                      Opacity="0.08"
                      ShadowDepth="1"
                      Color="#000000" />

    <!-- 保持 Windows 本地字体和桌面密度。 -->
    <FontFamily x:Key="UiFontFamily">Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="MonoFontFamily">Consolas, Cascadia Mono, Microsoft YaHei UI</FontFamily>

    <Thickness x:Key="ButtonPadding">8,3,8,3</Thickness>
    <Thickness x:Key="InputPadding">8,3,8,3</Thickness>
    <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="PanelCornerRadius">4</CornerRadius>

</ResourceDictionary>
