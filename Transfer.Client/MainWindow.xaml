<Window x:Class="Transfer.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="文件互传 · 客户端"
        Width="1120" Height="680" MinWidth="820" MinHeight="500"
        Background="{DynamicResource CanvasBrush}"
        Foreground="{DynamicResource InkBrush}"
        FontFamily="{DynamicResource UiFontFamily}"
        FontSize="12"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel Margin="16">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="文件互传" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="客户端" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
            </StackPanel>
            <Button Content="打开日志目录"
                    Click="OpenLogs_Click"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Style="{StaticResource GhostButton}" />
        </Grid>

        <Border DockPanel.Dock="Bottom" Height="24" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse x:Name="StatusDot" Width="5" Height="5" Fill="{StaticResource MutedBrush}" Margin="0,0,6,0" />
                <TextBlock x:Name="StatusText"
                           Text="尚未连接"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{StaticResource MutedBrush}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>

        <StackPanel>
            <Grid Margin="0,0,0,10">
                <Border Background="{StaticResource SurfaceBrush}"
                        CornerRadius="{StaticResource PanelCornerRadius}"
                        Effect="{StaticResource CardShadow}" />
                <Border Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource PanelCornerRadius}"
                        Padding="12">
                <StackPanel>
                    <TextBlock Text="连接设置"
                               Style="{StaticResource SectionLabel}"
                               Margin="0,0,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="服务端地址" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                        <TextBox x:Name="HostBox" Grid.Column="1" Margin="8,0" Text="127.0.0.1" />
                        <TextBlock Grid.Column="2" Text=":" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                        <TextBox x:Name="PortBox" Grid.Column="3" Margin="8,0" Text="9500" />
                        <Button x:Name="ConnectButton"
                                Grid.Column="4"
                                Content="连接 / 刷新文件"
                                Click="Connect_Click"
                                MinWidth="112"
                                Style="{StaticResource PrimaryButton}" />
                    </Grid>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="下载保存目录" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                        <TextBox x:Name="FolderBox" Grid.Column="1" Margin="8,0" IsReadOnly="True" />
                        <Button Grid.Column="2" Content="选择文件夹" Click="Folder_Click" Style="{StaticResource SecondaryButton}" />
                    </Grid>

                    <WrapPanel Margin="0,8,0,0">
                        <TextBlock Text="并发连接数" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                        <TextBox x:Name="ThreadsBox" Text="4" Width="60" Margin="8,0" />
                        <TextBlock Text="1～16" VerticalAlignment="Center" FontSize="11"
                                   Foreground="{StaticResource SubtleBrush}" Margin="0,0,10,0" />
                        <Button Content="下载所选 / 继续" Click="Download_Click" Margin="0,0,4,0"
                                Style="{StaticResource PrimaryButton}" />
                        <Button Content="暂停所选" Click="Pause_Click" Margin="0,0,4,0"
                                Style="{StaticResource SecondaryButton}" />
                        <Button Content="全部暂停" Click="PauseAll_Click" Style="{StaticResource SecondaryButton}" />
                    </WrapPanel>
                </StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="按 Ctrl / Shift 多选文件。暂停、关闭或断网后保留临时文件；选择原目录即可继续。"
                       FontSize="11"
                       Foreground="{StaticResource MutedBrush}"
                       Margin="2,0,0,8"
                       TextWrapping="Wrap" />

            <Grid>
                <DataGrid x:Name="FileGrid"
                          ItemsSource="{Binding Files}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Extended"
                          SelectionUnit="FullRow">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="文件名" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="大小" Binding="{Binding Size}" Width="105" />
                    <DataGridTemplateColumn Header="下载进度" Width="185">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid Margin="5">
                                    <ProgressBar Value="{Binding Percent}" Maximum="100" Height="24" />
                                    <TextBlock Text="{Binding Percent, StringFormat={}{0:F1}%}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="速度" Binding="{Binding Speed}" Width="90" />
                    <DataGridTextColumn Header="剩余" Binding="{Binding Remaining}" Width="90" />
                    <DataGridTextColumn Header="已下载 / 总量 / 会话" Binding="{Binding Detail}" Width="285" />
                    <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="100" />
                </DataGrid.Columns>
            </DataGrid>

            <Border x:Name="EmptyState"
                    Margin="1,27,1,1"
                    Background="{StaticResource SurfaceBrush}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,36,0,0">
                    <TextBlock x:Name="EmptyText"
                               HorizontalAlignment="Center"
                               FontSize="12"
                               Foreground="{StaticResource MutedBrush}"
                               Text="连接服务端后选择要下载的文件" />
                    <Button x:Name="EmptyAction"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Center"
                            Content="连接 / 刷新"
                            Click="Connect_Click"
                            Style="{StaticResource PrimaryButton}" />
                </StackPanel>
            </Border>
            </Grid>
        </StackPanel>
    </DockPanel>
</Window>
