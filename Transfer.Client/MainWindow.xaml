<Window x:Class="Transfer.Client.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="文件互传 · 客户端" Width="1120" Height="680" MinWidth="820" MinHeight="500" Background="#F3F5F8">
<DockPanel Margin="20"><StackPanel DockPanel.Dock="Top"><Button Content="打开日志目录" Click="OpenLogs_Click" HorizontalAlignment="Right"/><TextBlock Text="文件互传 / 客户端" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,14"/><WrapPanel><TextBlock Text="服务端地址" VerticalAlignment="Center"/><TextBox x:Name="HostBox" Text="127.0.0.1" Width="175" Margin="8,0"/><TextBlock Text="端口" VerticalAlignment="Center"/><TextBox x:Name="PortBox" Text="9500" Width="75" Margin="8,0"/><Button x:Name="ConnectButton" Content="连接 / 刷新文件" Click="Connect_Click"/></WrapPanel><Grid Margin="0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="下载保存目录" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox x:Name="FolderBox" Grid.Column="1" IsReadOnly="True"/><Button Grid.Column="2" Content="选择文件夹" Click="Folder_Click"/></Grid><WrapPanel><TextBlock Text="每个文件并发连接数（1～16）" VerticalAlignment="Center"/><TextBox x:Name="ThreadsBox" Text="4" Width="55" Margin="8,0"/><Button Content="下载所选 / 继续" Click="Download_Click"/><Button Content="暂停所选" Click="Pause_Click"/><Button Content="全部暂停" Click="PauseAll_Click"/></WrapPanel><TextBlock Text="按 Ctrl / Shift 多选文件。暂停、关闭或断网后保留临时文件；选择原目录即可继续。" Foreground="#64748B" Margin="0,8,0,12" TextWrapping="Wrap"/></StackPanel><TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Text="尚未连接" TextWrapping="Wrap" Margin="0,12,0,0"/>
<DataGrid x:Name="FileGrid" ItemsSource="{Binding Files}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow"><DataGrid.Columns><DataGridTextColumn Header="文件名" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="大小" Binding="{Binding Size}" Width="105"/><DataGridTemplateColumn Header="下载进度" Width="185"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid Margin="5"><ProgressBar Value="{Binding Percent}" Maximum="100" Height="24"/><TextBlock Text="{Binding Percent, StringFormat={}{0:F1}%}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="已下载 / 总量 / 会话" Binding="{Binding Detail}" Width="285"/><DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="100"/></DataGrid.Columns></DataGrid>
</DockPanel></Window>
