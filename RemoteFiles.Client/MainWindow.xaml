<Window x:Class="RemoteFiles.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RemoteFiles.Desktop"
        Title="远程文件管理 · 客户端"
        Width="1280" Height="800" MinWidth="1000" MinHeight="600"
        Background="{DynamicResource CanvasBrush}"
        Foreground="{DynamicResource InkBrush}"
        FontFamily="{DynamicResource UiFontFamily}"
        FontSize="12"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <!-- 连接工具条：不再使用卡片，直接嵌在窗口顶部。 -->
        <Border DockPanel.Dock="Top"
                Height="40"
                Padding="12,0"
                Background="{StaticResource HeaderBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}"
                               Text="服务端" />
                    <TextBox x:Name="HostBox"
                             Width="170"
                             VerticalAlignment="Center"
                             Text="127.0.0.1" />
                    <TextBlock Margin="4,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}"
                               Text=":" />
                    <TextBox x:Name="PortBox"
                             Width="64"
                             VerticalAlignment="Center"
                             Text="9501" />
                    <Button x:Name="ConnectButton"
                            MinWidth="72"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Click="Connect_Click"
                            Content="连接"
                            Style="{StaticResource PrimaryButton}" />
                    <Ellipse x:Name="ConnectionDot"
                             Width="5" Height="5"
                             Margin="14,0,6,0"
                             Fill="{StaticResource MutedBrush}" />
                    <TextBlock x:Name="ConnectionText"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{StaticResource MutedBrush}"
                               Text="未连接" />
                </StackPanel>
                <Button HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Click="Logs_Click"
                        Content="日志"
                        Style="{StaticResource GhostButton}"
                        ToolTip="打开日志目录" />
            </Grid>
        </Border>

        <!-- 底部状态栏：原生高度，只保留状态和必要信息。 -->
        <Border DockPanel.Dock="Bottom"
                Height="24"
                Padding="12,0"
                Background="{StaticResource HeaderBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,1,0,0"
                ToolTip="协议未加密，请仅在可信局域网使用。">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="StatusDot"
                         Width="5" Height="5"
                         Margin="0,0,6,0"
                         Fill="{StaticResource MutedBrush}" />
                <TextBlock Grid.Column="1"
                           x:Name="StatusText"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{StaticResource MutedBrush}"
                           Text="就绪"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2"
                           x:Name="SelectionText"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Margin="12,0,0,0"
                           Foreground="{StaticResource MutedBrush}" />
                <StackPanel Grid.Column="3"
                            x:Name="BrowserProgressPanel"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <TextBlock x:Name="BrowserProgressText"
                               MaxWidth="240"
                               Margin="12,0,8,0"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{StaticResource MutedBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <ProgressBar x:Name="BrowserProgress"
                                 Width="120"
                                 Height="6"
                                 Maximum="100" />
                </StackPanel>
            </Grid>
        </Border>

        <local:RemoteBrowser x:Name="Browser" Margin="12,10,12,0" />
    </DockPanel>
</Window>
