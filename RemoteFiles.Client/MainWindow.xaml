<Window x:Class="RemoteFiles.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RemoteFiles.Desktop"
        xmlns:desktop="clr-namespace:Transfer.Desktop"
        Title="远程文件管理 · 客户端"
        Icon="Assets/FileTransfer.Client.ico"
        desktop:ThemeManager.MatchCaptionToCanvas="True"
        Width="1280" Height="800" MinWidth="1000" MinHeight="600"
        Background="{DynamicResource CanvasBrush}"
        Foreground="{DynamicResource InkBrush}"
        FontFamily="{DynamicResource UiFontFamily}"
        FontSize="12"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <Style x:Key="ConnectPrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Foreground" Value="{DynamicResource CanvasBrush}" />
        </Style>
    </Window.Resources>

    <DockPanel Background="{DynamicResource CanvasBrush}">
        <!-- 连接设置与窗口级命令。 -->
        <Border DockPanel.Dock="Top"
                Margin="12,8,12,0"
                MinHeight="46"
                Padding="12,0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="1"
                CornerRadius="7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Margin="0,0,10,0"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Text="服务端" />
                    <TextBox x:Name="HostBox"
                             Width="176"
                             Style="{StaticResource RoundedTextInput}"
                             AutomationProperties.Name="服务端地址"
                             VerticalAlignment="Center"
                             Text="127.0.0.1" />
                    <TextBlock Margin="4,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedBrush}"
                               Text=":" />
                    <TextBox x:Name="PortBox"
                             Width="64"
                             Style="{StaticResource RoundedTextInput}"
                             AutomationProperties.Name="服务端端口"
                             VerticalAlignment="Center"
                             Text="9501" />
                    <Button x:Name="ConnectButton"
                            MinWidth="82" Height="32"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Click="Connect_Click"
                            Content="连接"
                            Style="{StaticResource ConnectPrimaryButton}" />
                    <Border Margin="12,0,0,0" Padding="8,4" CornerRadius="5" VerticalAlignment="Center"
                            Background="{DynamicResource HeaderBrush}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ConnectionDot" Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center"
                                     Fill="{DynamicResource MutedBrush}" />
                            <TextBlock x:Name="ConnectionText" VerticalAlignment="Center" FontSize="11"
                                       Foreground="{DynamicResource MutedBrush}" Text="未连接" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="UpdateBadge"
                            Margin="0,0,2,0"
                            Click="UpdateBadge_Click"
                            Style="{StaticResource UpdateIconButton}"
                            ToolTip="发现新版本，点击更新"
                            Visibility="Collapsed">
                        <Path Data="{StaticResource IconUpdateGeometry}" Style="{StaticResource IconGlyph}" />
                    </Button>
                    <Button x:Name="ThemeButton"
                            Margin="0,0,2,0"
                            Click="Theme_Click"
                            Style="{StaticResource IconButton}"
                            ToolTip="切换到夜间模式">
                        <Path x:Name="ThemeIcon" Data="{StaticResource IconMoonGeometry}" Style="{StaticResource IconGlyph}" />
                    </Button>
                    <Button Click="Logs_Click"
                            Style="{StaticResource IconButton}"
                            ToolTip="打开日志目录">
                        <Path Data="{StaticResource IconLogsGeometry}" Style="{StaticResource IconGlyph}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 底部状态栏：左侧操作反馈，右侧选择与传输进度。 -->
        <Border DockPanel.Dock="Bottom"
                Height="32"
                Padding="16,0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource HairlineBrush}"
                BorderThickness="0,1,0,0"
                ToolTip="协议未加密，请仅在可信局域网使用。">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="StatusDot"
                         Width="6" Height="6"
                         Margin="0,0,8,0"
                         VerticalAlignment="Center"
                         Fill="{DynamicResource MutedBrush}" />
                <TextBlock Grid.Column="1"
                           x:Name="StatusText"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{DynamicResource InkBrush}"
                           Text="就绪"
                           TextTrimming="CharacterEllipsis" />
                <Border Grid.Column="2" Margin="12,0,0,0" Padding="8,3" CornerRadius="5"
                        VerticalAlignment="Center" Background="{DynamicResource AccentSoftBrush}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SelectionText}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock x:Name="SelectionText" FontSize="11" Foreground="{DynamicResource AccentBrush}" />
                </Border>
                <StackPanel Grid.Column="3"
                            x:Name="BrowserProgressPanel"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <TextBlock x:Name="BrowserProgressText"
                               MaxWidth="240"
                               Margin="12,0,8,0"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{DynamicResource MutedBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <ProgressBar x:Name="BrowserProgress"
                                 Width="120"
                                 Height="6"
                                 VerticalAlignment="Center"
                                 Maximum="100" />
                </StackPanel>
            </Grid>
        </Border>

        <local:RemoteBrowser x:Name="Browser" Margin="12,8,12,8" />
    </DockPanel>
</Window>
