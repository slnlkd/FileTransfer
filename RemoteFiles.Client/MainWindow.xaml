<Window x:Class="RemoteFiles.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RemoteFiles.Desktop"
        xmlns:desktop="clr-namespace:Transfer.Desktop"
        Title="远程文件管理 · 客户端"
        Icon="Assets/FileTransfer.Client.ico"
        desktop:ThemeManager.MatchCaptionToCanvas="True"
        Width="1280" Height="800" MinWidth="1000" MinHeight="600"
        Background="{DynamicResource CanvasBrush}"
        Foreground="{DynamicResource InkBrush}"
        FontFamily="{DynamicResource UiFontFamily}"
        FontSize="12"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <Style x:Key="ConnectToolbarButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}" />
        <Style x:Key="ConnectPrimaryButton" TargetType="Button" BasedOn="{StaticResource ConnectToolbarButton}">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="ToolTip" Value="连接所选服务端" />
            <Setter Property="AutomationProperties.Name" Value="连接" />
        </Style>
        <Style x:Key="ReconnectIconButton" TargetType="Button" BasedOn="{StaticResource ConnectToolbarButton}">
            <Setter Property="Width" Value="{StaticResource ToolbarControlHeight}" />
            <Setter Property="MinWidth" Value="{StaticResource ToolbarControlHeight}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ToolTip" Value="重新连接所选服务端" />
            <Setter Property="AutomationProperties.Name" Value="重新连接" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Path Data="M13,3 V7 H9 M13,7 A5,5 0 1 0 12.5,11" Style="{StaticResource IconGlyph}" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ServerEndpointItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBackground" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBackground" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBackground" Property="Background" Value="{DynamicResource RowHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ServerEndpointInput" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource ServerEndpointItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource ControlCornerRadius}">
                                <DockPanel>
                                    <ToggleButton DockPanel.Dock="Right" Width="28" Focusable="False" ClickMode="Press"
                                                  AutomationProperties.Name="展开服务端列表"
                                                  IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="ArrowBackground" Background="Transparent" CornerRadius="0,3,3,0">
                                                    <Path Data="M2,2 L6,6 L10,2" Stroke="{DynamicResource MutedBrush}"
                                                          StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ArrowBackground" Property="Background" Value="{DynamicResource RowHoverBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <TextBox x:Name="PART_EditableTextBox" Background="Transparent" BorderThickness="0"
                                             Padding="8,0" VerticalContentAlignment="Center" IsReadOnly="{TemplateBinding IsReadOnly}"
                                             AutomationProperties.Name="服务端地址和端口" />
                                </DockPanel>
                            </Border>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border MinWidth="{TemplateBinding ActualWidth}" Style="{StaticResource PopupSurface}">
                                    <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}" VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled" CanContentScroll="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel Background="{DynamicResource CanvasBrush}">
        <!-- 连接设置与窗口级命令。 -->
        <Border DockPanel.Dock="Top"
                Padding="{StaticResource BrowserToolbarPadding}"
                Background="{DynamicResource HeaderBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Margin="0,0,8,0" FontSize="11"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedBrush}"
                               Text="服务端" />
                    <ComboBox x:Name="EndpointBox" Width="196" Height="{StaticResource ToolbarControlHeight}" VerticalAlignment="Center"
                              IsEditable="True" IsTextSearchEnabled="False" MaxDropDownHeight="260"
                              Style="{StaticResource ServerEndpointInput}"
                              AutomationProperties.Name="服务端地址和端口"
                              ToolTip="选择或输入地址和端口，例如 10.100.40.181:9501"
                              PreviewKeyDown="EndpointBox_PreviewKeyDown" />
                    <Ellipse x:Name="ConnectionDot" Width="6" Height="6" Margin="10,0,6,0" VerticalAlignment="Center"
                             Fill="{DynamicResource MutedBrush}" />
                    <TextBlock x:Name="ConnectionText" VerticalAlignment="Center" FontSize="11"
                               Foreground="{DynamicResource MutedBrush}" Text="未连接" />
                    <Button x:Name="ConnectButton"
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            Click="Connect_Click"
                            Content="连接"
                            Style="{StaticResource ConnectPrimaryButton}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="UpdateBadge"
                            Margin="0,0,2,0"
                            Height="{StaticResource ToolbarControlHeight}"
                            Click="UpdateBadge_Click"
                            Style="{StaticResource UpdateIconButton}"
                            AutomationProperties.Name="下载并安装更新"
                            ToolTip="发现新版本，点击更新"
                            Visibility="Collapsed">
                        <Path Data="{StaticResource IconDownloadGeometry}" Style="{StaticResource IconGlyph}" />
                    </Button>
                    <Button x:Name="ThemeButton"
                            Margin="0,0,2,0"
                            Click="Theme_Click"
                            Style="{StaticResource RoundIconButton}"
                            AutomationProperties.Name="切换日间或夜间模式"
                            ToolTip="切换到夜间模式">
                        <Path x:Name="ThemeIcon" Data="{StaticResource IconMoonGeometry}" Style="{StaticResource SmallIconGlyph}" />
                    </Button>
                    <Button Click="Logs_Click"
                            Style="{StaticResource RoundIconButton}"
                            AutomationProperties.Name="查看日志"
                            ToolTip="查看日志">
                        <Path Data="{StaticResource IconLogsGeometry}" Style="{StaticResource SmallIconGlyph}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 底部状态栏：左侧操作反馈，右侧选择与传输进度。 -->
        <Border DockPanel.Dock="Bottom"
                Height="32"
                Padding="16,0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource HairlineBrush}"
                BorderThickness="0,1,0,0"
                ToolTip="协议未加密，请仅在可信局域网使用。">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="StatusDot"
                         Width="6" Height="6"
                         Margin="0,0,8,0"
                         VerticalAlignment="Center"
                         Fill="{DynamicResource MutedBrush}" />
                <TextBlock Grid.Column="1"
                           x:Name="StatusText"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{DynamicResource InkBrush}"
                           Text="就绪"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="SelectionText" Grid.Column="2"
                           Margin="12,0,0,0" VerticalAlignment="Center"
                           FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                <StackPanel Grid.Column="3"
                            x:Name="BrowserProgressPanel"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <TextBlock x:Name="BrowserProgressText"
                               MaxWidth="240"
                               Margin="12,0,8,0"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{DynamicResource MutedBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <ProgressBar x:Name="BrowserProgress"
                                 Width="120"
                                 Height="6"
                                 VerticalAlignment="Center"
                                 Maximum="100" />
                </StackPanel>
            </Grid>
        </Border>

        <local:RemoteBrowser x:Name="Browser" />
    </DockPanel>
</Window>
