<Window x:Class="RemoteFiles.Client.AnnotationDatabaseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RemoteFiles.Client"
        Width="950" Height="600" MinWidth="700" MinHeight="440" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource InkBrush}"
        UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="AnnotationDatabaseStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <TabControl Margin="16,10,16,16">
        <TabControl.Template>
            <ControlTemplate TargetType="TabControl">
                <DockPanel KeyboardNavigation.TabNavigation="Local">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <Button DockPanel.Dock="Right" Content="验证数据库" IsEnabled="{Binding CanVerify}"
                                Click="Verify_Click" Style="{DynamicResource FormButton}" Margin="12,0,0,0"
                                VerticalAlignment="Center"/>
                        <TabPanel IsItemsHost="True" KeyboardNavigation.TabNavigation="Once"/>
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,0,0,6"
                               Foreground="{DynamicResource MutedBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"
                                      KeyboardNavigation.TabNavigation="Local"/>
                </DockPanel>
            </ControlTemplate>
        </TabControl.Template>
        <TabItem Header="数据表">
            <DataGrid ItemsSource="{Binding Tables}" IsReadOnly="True" AutoGenerateColumns="False"
                      CanUserAddRows="False" HeadersVisibility="Column" RowDetailsVisibilityMode="VisibleWhenSelected">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="用途" Binding="{Binding Role}" Width="125"
                                        ElementStyle="{StaticResource AnnotationTableText}"/>
                    <DataGridTextColumn Header="默认表" Binding="{Binding DefaultName}" Width="*"
                                        ElementStyle="{StaticResource AnnotationTableText}"/>
                    <DataGridTextColumn Header="实际表" Binding="{Binding ActualName, TargetNullValue=未解析}" Width="*"
                                        ElementStyle="{StaticResource AnnotationTableText}"/>
                    <DataGridTemplateColumn Header="验证" SortMemberPath="ValidationState" Width="76">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource AnnotationValidationText}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
                <DataGrid.RowDetailsTemplate>
                    <DataTemplate>
                        <StackPanel Margin="12,6">
                            <TextBlock Text="{Binding Access}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Details}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </DataGrid.RowDetailsTemplate>
            </DataGrid>
        </TabItem>
        <TabItem Header="SQL 模板">
            <Grid Margin="8">
                <TextBlock Text="{Binding SqlStatus}" TextWrapping="Wrap" Margin="4"
                           Foreground="{DynamicResource MutedBrush}"/>
                <DockPanel>
                    <DockPanel.Style>
                        <Style TargetType="DockPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSqlTemplates}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DockPanel.Style>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8"
                               Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}"
                               MaxWidth="590" HorizontalAlignment="Left">
                        <Button DockPanel.Dock="Right" Content="复制 SQL" Click="Copy_Click"
                                Style="{DynamicResource FormButton}" Margin="8,0,0,0"/>
                        <ComboBox x:Name="TemplatePicker" ItemsSource="{Binding SqlTemplates}" SelectedIndex="0"
                                  Style="{StaticResource SqlTemplatePicker}" AutomationProperties.Name="选择 SQL 模板">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding Operation, Mode=OneWay}" FontWeight="SemiBold"/>
                                        <Run Text=" · " Foreground="{DynamicResource MutedBrush}"/>
                                        <Run Text="{Binding Name, Mode=OneWay}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </DockPanel>
                    <local:SqlTemplatePreview x:Name="SqlText"
                                              Sql="{Binding SelectedItem.Sql, ElementName=TemplatePicker, Mode=OneWay}"
                                              FontFamily="{DynamicResource MonoFontFamily}"
                                              Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource InkBrush}"
                                              BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                              AutomationProperties.Name="参数化 SQL 模板"/>
                </DockPanel>
            </Grid>
        </TabItem>
    </TabControl>
</Window>
