<Window x:Class="Transfer.Server.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="文件互传 · 服务端" Width="1050" Height="680" MinWidth="760" MinHeight="480" AllowDrop="True" Drop="Files_Drop" DragOver="Files_DragOver" Background="#F3F5F8">
<DockPanel Margin="20">
<StackPanel DockPanel.Dock="Top"><Button Content="打开日志目录" Click="OpenLogs_Click" HorizontalAlignment="Right"/><TextBlock Text="文件互传 / 服务端" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,14"/><WrapPanel><TextBlock Text="监听端口" VerticalAlignment="Center"/><TextBox x:Name="PortBox" Text="9500" Width="90" Margin="8,0"/><Button x:Name="StartButton" Content="启动服务" Click="Start_Click"/><Button x:Name="StopButton" Content="停止服务" Click="Stop_Click" IsEnabled="False"/><Button Content="添加共享文件" Click="Add_Click"/><Button Content="添加共享文件夹" Click="AddFolder_Click"/></WrapPanel><Border BorderBrush="#94A3B8" BorderThickness="1" Padding="16" Margin="0,12" Background="White"><StackPanel><TextBlock Text="将文件拖到窗口，或点击添加共享文件" FontSize="16"/><TextBlock Text="保存原文件路径，客户端下载时读取源文件；请在传输期间保留源文件。" Foreground="#64748B" Margin="0,5,0,0"/></StackPanel></Border><TextBlock x:Name="StatusText" Text="服务尚未启动" Margin="0,0,0,10" TextWrapping="Wrap"/></StackPanel>
<TextBox x:Name="LogBox" DockPanel.Dock="Bottom" Height="90" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0"/>
<TabControl><TabItem Header="共享文件"><DataGrid x:Name="SharedFilesGrid" ItemsSource="{Binding Files}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow">
<DataGrid.ContextMenu><ContextMenu><MenuItem Header="移除所选共享文件（保留源文件）" Click="RemoveShared_Click"/></ContextMenu></DataGrid.ContextMenu>
<DataGrid.RowStyle><Style TargetType="DataGridRow"><EventSetter Event="PreviewMouseRightButtonDown" Handler="SharedRow_RightClick"/></Style></DataGrid.RowStyle>
<DataGrid.Columns><DataGridTextColumn Header="文件名" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="源文件路径" Binding="{Binding SourcePath}" Width="360"/><DataGridTextColumn Header="大小" Binding="{Binding Size}" Width="120"/><DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="130"/></DataGrid.Columns></DataGrid></TabItem><TabItem Header="客户端下载进度"><DataGrid ItemsSource="{Binding Transfers}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="文件名" Binding="{Binding Name}" Width="*"/><DataGridTemplateColumn Header="进度" Width="180"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid Margin="5"><ProgressBar Value="{Binding Percent}" Maximum="100" Height="22"/><TextBlock Text="{Binding Percent, StringFormat={}{0:F1}%}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="已下载 / 总量 / 客户端" Binding="{Binding Detail}" Width="300"/><DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="100"/></DataGrid.Columns></DataGrid></TabItem></TabControl>
</DockPanel></Window>
