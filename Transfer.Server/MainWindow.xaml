<Window x:Class="Transfer.Server.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="文件互传 · 服务端"
        Width="1050" Height="680" MinWidth="760" MinHeight="480"
        AllowDrop="True" Drop="Files_Drop" DragOver="Files_DragOver"
        Background="{DynamicResource CanvasBrush}"
        Foreground="{DynamicResource InkBrush}"
        FontFamily="{DynamicResource UiFontFamily}"
        FontSize="12"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel Margin="16">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="文件互传" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="服务端" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
            </StackPanel>
            <Button Content="打开日志目录"
                    Click="OpenLogs_Click"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Style="{StaticResource GhostButton}" />
        </Grid>

        <Border DockPanel.Dock="Bottom" Height="24" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse x:Name="StatusDot" Width="5" Height="5" Fill="{StaticResource MutedBrush}" Margin="0,0,6,0" />
                <TextBlock x:Name="StatusText"
                           Text="服务尚未启动"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{StaticResource MutedBrush}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>

        <TextBox x:Name="LogBox"
                 DockPanel.Dock="Bottom"
                 Height="90"
                 Margin="0,8,0,0"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 VerticalContentAlignment="Top"
                 Padding="8"
                 FontFamily="{StaticResource MonoFontFamily}"
                 FontSize="11" />

        <StackPanel DockPanel.Dock="Top">
            <Grid Margin="0,0,0,10">
                <Border Background="{StaticResource SurfaceBrush}"
                        CornerRadius="{StaticResource PanelCornerRadius}"
                        Effect="{StaticResource CardShadow}" />
                <Border Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource PanelCornerRadius}"
                        Padding="12">
                <StackPanel>
                    <TextBlock Text="服务设置"
                               Style="{StaticResource SectionLabel}"
                               Margin="0,0,0,8" />
                    <WrapPanel>
                        <TextBlock Text="监听端口" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                        <TextBox x:Name="PortBox" Text="9500" Width="90" Margin="8,0" />
                        <Button x:Name="StartButton" Content="启动服务" Click="Start_Click" Margin="0,0,4,0"
                                Style="{StaticResource PrimaryButton}" />
                        <Button x:Name="StopButton" Content="停止服务" Click="Stop_Click" Margin="0,0,4,0"
                                IsEnabled="False" Style="{StaticResource DangerButton}" />
                        <Button Content="添加共享文件" Click="Add_Click" Margin="0,0,4,0"
                                Style="{StaticResource SecondaryButton}" />
                        <Button Content="添加共享文件夹" Click="AddFolder_Click"
                                Style="{StaticResource SecondaryButton}" />
                    </WrapPanel>

                    <Border Background="{StaticResource HeaderBrush}"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource PanelCornerRadius}"
                            Padding="12"
                            Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="将文件拖到窗口，或点击添加共享文件" />
                            <TextBlock Text="保存原文件路径，客户端下载时读取源文件；请在传输期间保留源文件。"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                </Border>
            </Grid>

            <TabControl Margin="0,0,0,0">
                <TabItem Header="共享文件">
                    <Grid>
                    <DataGrid x:Name="SharedFilesGrid"
                              ItemsSource="{Binding Files}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Extended"
                              SelectionUnit="FullRow">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="移除所选共享文件（保留源文件）" Click="RemoveShared_Click" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <EventSetter Event="PreviewMouseRightButtonDown" Handler="SharedRow_RightClick" />
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="文件名" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="源文件路径" Binding="{Binding SourcePath}" Width="360" />
                            <DataGridTextColumn Header="大小" Binding="{Binding Size}" Width="120" />
                            <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="130" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Margin="1,27,1,1" Background="{StaticResource SurfaceBrush}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Items.Count, ElementName=SharedFilesGrid}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,36,0,0">
                            <TextBlock Text="尚未添加共享文件" FontSize="12" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="把文件拖到窗口，或点击上方“添加共享文件”" FontSize="11" Foreground="{StaticResource SubtleBrush}" Margin="0,6,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    </Grid>
                </TabItem>
                <TabItem Header="客户端下载进度">
                    <Grid>
                    <DataGrid x:Name="TransferGrid" ItemsSource="{Binding Transfers}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="文件名" Binding="{Binding Name}" Width="*" />
                            <DataGridTemplateColumn Header="进度" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Margin="5">
                                            <ProgressBar Value="{Binding Percent}" Maximum="100" Height="22" />
                                            <TextBlock Text="{Binding Percent, StringFormat={}{0:F1}%}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="速度" Binding="{Binding Speed}" Width="90" />
                            <DataGridTextColumn Header="剩余" Binding="{Binding Remaining}" Width="90" />
                            <DataGridTextColumn Header="已下载 / 总量 / 客户端" Binding="{Binding Detail}" Width="300" />
                            <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Margin="1,27,1,1" Background="{StaticResource SurfaceBrush}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Items.Count, ElementName=TransferGrid}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,36,0,0">
                            <TextBlock Text="暂无客户端下载任务" FontSize="12" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="客户端开始下载后会在这里显示进度" FontSize="11" Foreground="{StaticResource SubtleBrush}" Margin="0,6,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </StackPanel>
    </DockPanel>
</Window>
